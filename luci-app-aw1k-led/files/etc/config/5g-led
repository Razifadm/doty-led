
config led_power
	option enable '1'

config led_5g
	option enable '1'

config led_mobile_signal
	option enable '1'

config led_wifi
	option enable '1'

config led_internate
	option enable '1'

config led_phone
	option enable '1'

config 5g_quality 'excellent'
	option min_snr '25'
	option color 'green'

config 5g_quality 'good'
